<?php

/**
 * @file
 * Funções de pré-processamento e configurações do tema FFLCH.
 */

use Drupal\Core\Form\FormStateInterface;
use Drupal\Core\Template\Attribute;
use Drupal\file\Entity\File;

if (!defined('THEME_PATH_FFLCH')) {
  if (\Drupal::hasService('extension.list.theme')) {
    define('THEME_PATH_FFLCH', base_path() . \Drupal::service('extension.list.theme')->getPath('fflch'));
  }
  elseif (function_exists('drupal_get_path')) {
    define('THEME_PATH_FFLCH', base_path() . drupal_get_path('theme', 'fflch'));
  }
  else {
    define('THEME_PATH_FFLCH', base_path() . 'themes/contrib/fflch-theme');
  }
}

